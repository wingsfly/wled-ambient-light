# 原厂板 ESP32-S3-WROOM-1-N8R2：8 MB flash + 2 MB quad PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_nova.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
# 内存策略照原厂：malloc 一律优先 PSRAM（阈值 0；WiFi/DMA 等必须内部的分配自带 MALLOC_CAP_INTERNAL），
# 并允许标了 EXT_RAM_BSS_ATTR 的静态缓冲区进 PSRAM。原厂板上实测运行时内部余量 95 KB 就是这套配置。
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# 原厂实际编译也是 -Os（顶层 CMakeLists 追加的 -Os 覆盖 -Og）；这里 Kconfig 与之一致
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Arduino 要求 1000 Hz；setup()/loop() 由 WLED 的 wled_main.cpp 提供
CONFIG_FREERTOS_HZ=1000
CONFIG_AUTOSTART_ARDUINO=y
# arduino-esp32 按需编译（同 0.4 spike）
CONFIG_ARDUINO_SELECTIVE_COMPILATION=y
CONFIG_ARDUINO_SELECTIVE_RainMaker=n
CONFIG_ARDUINO_SELECTIVE_Insights=n
CONFIG_ARDUINO_SELECTIVE_Zigbee=n
CONFIG_ARDUINO_SELECTIVE_OpenThread=n
CONFIG_ARDUINO_SELECTIVE_WiFiProv=n
CONFIG_ARDUINO_SELECTIVE_ESP_SR=n
CONFIG_ARDUINO_SELECTIVE_ESP_Video=n
CONFIG_ARDUINO_SELECTIVE_Matter=n
CONFIG_ARDUINO_SELECTIVE_BLE=n
CONFIG_ARDUINO_SELECTIVE_BluetoothSerial=n
CONFIG_ARDUINO_SELECTIVE_SimpleBLE=n
# ---- Matter：功能项照原厂 sdkconfig，必需项取自 esp-matter examples/light ----
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_ENABLE_WIFI_STATION=y
CONFIG_ENABLE_OTA_REQUESTOR=y
CONFIG_ENABLE_ROTATING_DEVICE_ID=y
CONFIG_ENABLE_ESP32_FACTORY_DATA_PROVIDER=y
# DAC 从原厂 esp_secure_cert 分区读 —— 复用原厂设备证书的前提
CONFIG_SEC_CERT_DAC_PROVIDER=y
CONFIG_CHIP_FACTORY_NAMESPACE_PARTITION_LABEL="fctry"
CONFIG_ESP_MATTER_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_MATTER_MAX_DEVICE_TYPE_COUNT=16
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=16
# 偏离原厂（原厂 =y）：WLED 已经通过 ESPmDNS 带了 espressif mdns 组件；Matter 再带一个精简
# 响应器会两个都监听 5353，既重复代码又冲突。让 Matter 走同一个 mdns 组件。
CONFIG_USE_MINIMAL_MDNS=n
# ---- 与原厂逐项对齐（2a.2 第二阶段对比原厂 sdkconfig 后补）----
# DAC 私钥：原厂不用 DS 外设，直接从 esp_secure_cert 分区读（分区受 flash 加密保护）
CONFIG_ESP_SECURE_CERT_DS_PERIPHERAL=n
# 设备实例信息（序列号等）从工厂分区读，不用示例值
CONFIG_ENABLE_ESP32_DEVICE_INSTANCE_INFO_PROVIDER=y
CONFIG_FACTORY_DEVICE_INSTANCE_INFO_PROVIDER=y
# 原厂 NVS 用 nvs_keys 分区里的密钥加密；不对齐的话新固件读到的全是乱码
CONFIG_NVS_ENCRYPTION=y
CONFIG_NVS_SEC_KEY_PROTECT_USING_FLASH_ENC=y
CONFIG_CHIP_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_CHIP_TASK_PRIORITY=14
CONFIG_CHIP_OTA_IMAGE_BUILD=y
# CHIP 的 soft-AP 配网关掉（原厂走 BLE）；WLED 自己的配网 AP 走 Arduino WiFi，不受影响
CONFIG_ENABLE_WIFI_AP=n
# ---- 安全：照原厂（Secure Boot V2 RSA + flash 加密 development 模式）----
# 构建签了名的镜像，体积核对才是真正要进槽的那个文件。只构建，不烧写；
# 构建产生的 bootloader 不会被使用（板上是原厂 bootloader，永不改动）。
CONFIG_SECURE_SIGNED_ON_BOOT=y
CONFIG_SECURE_SIGNED_ON_UPDATE=y
CONFIG_SECURE_SIGNED_APPS=y
CONFIG_SECURE_BOOT_V2_RSA_ENABLED=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
# 签名密钥永不入库：build.sh 把 NOVA_SIGNING_KEY 指向的密钥链接到这个文件名（已 gitignore）
CONFIG_SECURE_BOOT_SIGNING_KEY="secure_boot_signing_key.pem"
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_AES128=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT=y
CONFIG_SECURE_FLASH_UART_BOOTLOADER_ALLOW_ENC=y
CONFIG_SECURE_FLASH_ENCRYPT_ONLY_IMAGE_LEN_IN_APP_PART=y
CONFIG_SECURE_FLASH_CHECK_ENC_EN_IN_APP=y
CONFIG_SECURE_INSECURE_ALLOW_DL_MODE=y
# ---- 设备身份：照原厂。VID/PID 必须与 esp_secure_cert 里 DAC 证书的一致（复用原厂 Matter 身份的前提）----
CONFIG_DEVICE_VENDOR_ID=0x1656
CONFIG_DEVICE_PRODUCT_ID=0x0001
CONFIG_DEVICE_TYPE=269
