diff -ruN a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt	2026-10-27 22:21:16
+++ b/CMakeLists.txt	2026-10-27 22:21:16
@@ -441,6 +441,11 @@
   list(APPEND requires esp_driver_touch_sens)
 endif()
 
+# NOVA_SPIKE_EXCLUDE: I2C 从机实现用的 HAL 符号在 IDF 5.4.1 里不存在，WLED 用不到
+list(REMOVE_ITEM srcs "cores/esp32/esp32-hal-i2c-slave.c")
+# NOVA: Wire.cpp 的从机分支仍引用这些函数，以返回 ESP_ERR_NOT_SUPPORTED 的桩替代
+list(APPEND srcs "cores/esp32/esp32-hal-i2c-slave-stub.c")
+
 idf_component_register(INCLUDE_DIRS ${includedirs} PRIV_INCLUDE_DIRS ${priv_includes} SRCS ${srcs} REQUIRES ${requires} PRIV_REQUIRES ${priv_requires})
 
 if(NOT CONFIG_FREERTOS_HZ EQUAL 1000 AND NOT "$ENV{ARDUINO_SKIP_TICK_CHECK}")
@@ -519,14 +524,14 @@
 
 # Matter: skip CHIP InitWiFiStack when Thread or Ethernet is selected.
 # --wrap of a missing symbol is ignored (H2 has no Wi-Fi stack).
-if(CONFIG_ESP_MATTER_ENABLE_DATA_MODEL AND CONFIG_ENABLE_WIFI_STATION)
+if(CONFIG_ESP_MATTER_ENABLE_DATA_MODEL AND CONFIG_ENABLE_WIFI_STATION AND (NOT CONFIG_ARDUINO_SELECTIVE_COMPILATION OR CONFIG_ARDUINO_SELECTIVE_Matter))
   idf_build_set_property(LINK_OPTIONS "-Wl,--wrap=_ZN4chip11DeviceLayer8Internal10ESP32Utils13InitWiFiStackEv" APPEND)
   target_link_libraries(${COMPONENT_LIB} INTERFACE "-u __wrap__ZN4chip11DeviceLayer8Internal10ESP32Utils13InitWiFiStackEv")
 endif()
 
 # Matter data model: prefer SPIRAM when that heap exists (bypass malloc 4096 rule).
 # C++ mangled names from harvested libespressif__esp_matter.a (nm-confirmed).
-if(CONFIG_ESP_MATTER_ENABLE_DATA_MODEL)
+if(CONFIG_ESP_MATTER_ENABLE_DATA_MODEL AND (NOT CONFIG_ARDUINO_SELECTIVE_COMPILATION OR CONFIG_ARDUINO_SELECTIVE_Matter))
   idf_build_set_property(LINK_OPTIONS "-Wl,--wrap=_Z21esp_matter_mem_callocjj" APPEND)
   idf_build_set_property(LINK_OPTIONS "-Wl,--wrap=_Z22esp_matter_mem_reallocPvj" APPEND)
   idf_build_set_property(LINK_OPTIONS "-Wl,--wrap=_Z19esp_matter_mem_freePv" APPEND)
@@ -556,6 +561,8 @@
 endif()
 if(NOT CONFIG_ARDUINO_SELECTIVE_COMPILATION OR CONFIG_ARDUINO_SELECTIVE_Matter)
     maybe_add_component(espressif__esp_matter)
+    # NOVA: esp-matter 走 EXTRA_COMPONENT_DIRS 时组件名是 esp_matter，不是托管命名
+    maybe_add_component(esp_matter)
 
 endif()
 if(NOT CONFIG_ARDUINO_SELECTIVE_COMPILATION OR CONFIG_ARDUINO_SELECTIVE_LittleFS)
diff -ruN a/cores/esp32/esp32-hal-i2c-slave-stub.c b/cores/esp32/esp32-hal-i2c-slave-stub.c
--- a/cores/esp32/esp32-hal-i2c-slave-stub.c	1970-01-01 08:00:00
+++ b/cores/esp32/esp32-hal-i2c-slave-stub.c	2026-10-27 22:21:16
@@ -0,0 +1,31 @@
+// NOVA 补丁 2：esp32-hal-i2c-slave.c 用到的 HAL 符号（I2C_BUS_MODE_SLAVE、
+// i2c_ll_slave_set_fifo_mode）在 IDF 5.4.1 里不存在，编不过，已从 srcs 排除。
+// 但 Wire.cpp 的从机分支仍引用这几个函数，Wire 一被链入就缺符号。
+// WLED 不用 I2C 从机模式：以桩替代，调用即返回 ESP_ERR_NOT_SUPPORTED。
+#include "soc/soc_caps.h"
+#if SOC_I2C_SUPPORT_SLAVE
+// 头文件本身不 include stdbool 等，原实现是靠前面别的头带进来的
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include "esp_err.h"
+#include "esp32-hal-i2c-slave.h"
+#include "esp32-hal-log.h"
+
+esp_err_t i2cSlaveAttachCallbacks(uint8_t num, i2c_slave_request_cb_t request_callback, i2c_slave_receive_cb_t receive_callback, void *arg) {
+  return ESP_ERR_NOT_SUPPORTED;
+}
+
+esp_err_t i2cSlaveInit(uint8_t num, int sda, int scl, uint16_t slaveID, uint32_t frequency, size_t rx_len, size_t tx_len) {
+  log_e("I2C slave mode is not supported in this build");
+  return ESP_ERR_NOT_SUPPORTED;
+}
+
+esp_err_t i2cSlaveDeinit(uint8_t num) {
+  return ESP_ERR_NOT_SUPPORTED;
+}
+
+size_t i2cSlaveWrite(uint8_t num, const uint8_t *buf, uint32_t len, uint32_t timeout_ms) {
+  return 0;
+}
+#endif
